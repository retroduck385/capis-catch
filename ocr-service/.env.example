# Copy to .env (gitignored) and fill in. Never commit real keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key

# AI extraction (Gemini reads the OCR text, never the file). Leave empty to run OCR only.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, default gemini-3.8-flash
GEMINI_MODEL=
