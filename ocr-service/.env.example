# Copy to .env (gitignored) and fill in. Never commit real keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key

# AI extraction (Claude reads the OCR text, never the file) and the Credit Officer's AI suggestion (advise.py).
# Leave empty to run OCR only. SYNTHETIC TEST FILES ONLY until the data privacy question (Q-04) is cleared.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional, default claude-opus-5-5 (claude-sonnet-5-5 / claude-haiku-5-5 are cheaper)
ANTHROPIC_MODEL=

# Optional: 1 = run PaddleOCR without oneDNN (MKLDNN) on CPU. Only if every file fails with
# "ConvertPirAttribute2RuntimeAttribute not support [pir::ArrayAttribute<pir::DoubleAttribute>]". Slower; leave empty otherwise.
OCR_DISABLE_MKLDNN=
