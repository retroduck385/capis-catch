# Copy to .env (gitignored) and fill in. Never commit real keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key

# AI extraction (Claude reads the OCR text, never the file). Leave empty to run OCR only.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional, default claude-opus-5-5 (claude-sonnet-5-5 / claude-haiku-5-5 are cheaper)
ANTHROPIC_MODEL=
