# Copy to .env (gitignored) and fill in. Never commit real keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key

# The Credit Officer's AI suggestion for the credit result. The data privacy question (Q-04) was cleared by the bank
# on 2026-11-20; only de-identified figures and the policy findings are sent. Same key as ocr-service / mrac-service.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional, default claude-opus-5-5 (claude-sonnet-5-5 / claude-haiku-5-5 are cheaper)
ANTHROPIC_MODEL=
