# Copy to notice-service/.env (gitignored) and fill in. Never commit the real file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# log = print every SMS / email and mark it LOGGED, send nothing (default). live = send for real.
NOTICE_MODE=log

# Live mode only sends to these (comma-separated mobile numbers and email addresses: the team's own),
# until the Data Privacy sessions clear sending to applicants (Q-04). Others are printed and marked LOGGED.
NOTICE_LIVE_ALLOWLIST=

# SMS: Semaphore. Sender name must be approved by Semaphore first; leave empty to use their default.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Email: Brevo, with a single verified sender (no domain needed). The sender address must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CATCH
