SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # service role key (server side only, never in the React app)

# local = sentence-transformers (pip install sentence-transformers); hash = offline stub, NOT semantic (tests only)
EMBEDDING_PROVIDER=local
# Every worker must use the model the index was built with: the worker refuses to start otherwise.
# Switching models: stop all workers, change this, run `python -m mrac.ingest.reembed`.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# policy_chunks.embedding is vector(384). A model with another size needs a migration first.
EMBEDDING_DIM=384

# Cross-encoder that re-orders search candidates (better ranking, ~1 s per search). Empty = off.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# true while policy_chunks are still status='draft' (nothing reviewed yet). Set false once reviewers approve chunks.
RAG_INCLUDE_DRAFT=true

# Only for re-parsing the PDFs: words of the bank name in the page headers, separated by | (never commit the real name)
HEADER_NOISE_WORDS=

# Policy recommender (mrac/judge.py). No key = recommendations off; the rule check still runs.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (about USD 0.01 per check, team choice), claude-sonnet-5-5 or claude-opus-5-5 (slower, about 0.16 / 0.33)
MRAC_MODEL=claude-haiku-5-5
